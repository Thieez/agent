{
  "name": "gup-repo-agent",
  "version": "1.0.0",
  "private": true,
  "description": "Password-protected browser terminals for the gup repository.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/prepare-gup.js",
    "postinstall": "node scripts/prepare-gup.js",
    "start": "node scripts/install-terminal-dependencies.js && node server.js",
    "test": "node --test"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "express": "^5.1.0",
    "node-pty": "^1.1.0",
    "ws": "^8.18.3"
  },
  "allowScripts": {
    "node-pty@1.1.0": true
  }
}
